    "/api/dashboard/{subject_id}": {
      "get": {
        "summary": "Dashboard",
        "operationId": "dashboard_api_dashboard__subject_id__get",
        "parameters": [
          {
            "name": "subject_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$",
