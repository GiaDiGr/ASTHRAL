  "components": {
    "schemas": {
      "AudioInput": {
        "properties": {
          "monitoring_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Monitoring Id"
          },
          "evaluation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evaluation Id"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "es"
            ],
            "title": "Language"
          },
          "audio_base64": {
            "type": "string",
            "maxLength": 1800100,
            "minLength": 1,
            "title": "Audio Base64"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "language",
          "audio_base64"
        ],
        "title": "AudioInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{24,200}$",
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "Login"
      },
      "OperationMode": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "FULL",
              "LOW_POWER",
              "CRITICAL"
            ],
            "title": "Mode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "OperationMode"
      },
      "Question": {
        "properties": {
          "evaluation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evaluation Id"
          },
          "monitoring_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Monitoring Id"
          },
          "question": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 3,
            "title": "Question"
          },
          "documentary": {
            "type": "boolean",
            "title": "Documentary",
            "default": false
          },
          "history_context_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "History Context Id"
          },
          "history": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "title": "History"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "es"
            ],
            "title": "Language",
            "default": "es"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "Question"
      },
      "SpeechInput": {
        "properties": {
          "response_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Response Id"
          },
          "target_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Target Id"
          },
          "rate": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": -3.0,
            "title": "Rate",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "response_id",
          "target_id"
        ],
        "title": "SpeechInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}