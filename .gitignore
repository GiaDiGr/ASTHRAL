# ASTHRAL — share source, research, tests and reproducible build assets.
# Keep only machine-local state, private records and downloaded heavyweight runtimes out.

# Python and JS environments / caches (recreate with the lockfiles)
**/.venv/
**/venv/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.wrangler/
**/tts-toolchain/
**/*.pyc
**/*.pyd

# Local health records, credentials and per-machine configuration
**/*.sqlite*
**/*.db
**/*.dpapi
**/.env
**/.env.*
**/*portal-config*.json
**/*tokens*.json
**/*token*.txt
**/*portal-access*.txt

