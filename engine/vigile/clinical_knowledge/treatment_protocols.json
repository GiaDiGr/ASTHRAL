        "DO_NOT_USE_DIURETICS_TO_PREVENT_AKI",
        "DO_NOT_USE_DIURETICS_TO_TREAT_AKI_EXCEPT_VOLUME_OVERLOAD"
      ],
      "mission_approved": false,
      "automatic_execution": false
    },
